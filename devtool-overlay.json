    "target": "studyflow_android",
    "expected_target_type": "android",
    "notes": "Built cumulatively against the supplied StudyFlow snapshot plus OV01 through OV06. Intermediate roadmap overlay: apply with --no-validate, then run scripts/validate_ov07_backup_snapshot_saf_manual_sync.sh."
