    "enabled": true,
    "strategy": "single",
    "message": "OV17: harden attention delivery widget and remote policy"
  },
  "baseline": {
    "repo": "studyflow",
    "target": "studyflow_android",
    "expected_target_type": "android",
    "notes": "Built cumulatively on successful OV16 user-side apply after OV15 commit d5a58e0e."
  },
