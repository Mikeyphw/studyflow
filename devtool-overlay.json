{
  "schema_version": 1,
  "name": "studyflow_ov18_native_tv_durable_state_action_journal_v1",
  "target": "studyflow_android",
  "description": "OV18 closes native Android TV durable canonical state and action-journal findings with persistent outbox snapshots, durable command sequencing, explicit backpressure, wall-clock-free admission, persisted TV UI cursors and commit-before-success phone\u2194TV credentials.",
  "commit": {
    "enabled": true,
    "strategy": "single",
    "message": "OV18: harden native TV durable state and action journal"
  },
  "baseline": {
    "repo": "studyflow",
    "target": "studyflow_android",
    "expected_target_type": "android",
    "notes": "Built cumulatively on successful OV17 user-side apply after OV15 commit d5a58e0e and OV16/OV17 applied."
  },
  "structure": {
    "format": 1,
    "name": "studyflow_ov18_native_tv_durable_state_action_journal_v1",
    "target": "studyflow_android",
    "sections": [
      {
        "id": "ov18-domain-action-journal",
        "purpose": "Persist canonical TV mutation requests and acknowledgements, preserve pending order, and reject overflow with explicit backpressure instead of dropping oldest actions.",
        "paths": [
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/domain/StudyFlowTvDomainActionOutbox.kt",
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/domain/AndroidStudyFlowTvDomainActionOutboxPersistence.kt",
          "app-tv/src/test/java/com/mikeyphw/studyflow/tv/domain/StudyFlowTvDomainActionOutboxOv18DurabilityTest.kt"
        ]
      },
      {
        "id": "ov18-command-sequencing",
        "purpose": "Move TV-local command identifiers out of Activity memory and reserve each id through committed persistent storage before exposure.",
        "paths": [
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/domain/StudyFlowTvDurableCommandSequencer.kt",
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/StudyFlowTvActivity.kt"
        ]
      },
      {
        "id": "ov18-wall-clock-free-admission",
        "purpose": "Remove stale command and presentation rejection based on unsynchronized phone/TV wall clocks while preserving id-based replay barriers.",
        "paths": [
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/control/StudyFlowTvControlStateReducer.kt",
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/presentation/StudyFlowTvPresentationAdapter.kt",
          "app-tv/src/test/java/com/mikeyphw/studyflow/tv/control/StudyFlowTvControlStateReducerOv18ClockTest.kt"
        ]
      },
      {
        "id": "ov18-tv-ui-state",
        "purpose": "Persist destination, search and material-viewer cursors outside Activity memory so TV shell state survives recreation/restart.",
        "paths": [
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/StudyFlowTvDurableUiStateStore.kt",
          "app-tv/src/main/java/com/mikeyphw/studyflow/tv/StudyFlowTvActivity.kt"
        ]
      },
      {
        "id": "ov18-trust-and-credential-commit",
        "purpose": "Declare SFLP trust as the canonical TV trust authority and synchronously commit phone\u2194TV credentials before publishing paired success.",
        "paths": [
          "core/tvlink/src/main/kotlin/com/mikeyphw/studyflow/core/tvlink/StudyFlowTvLocalLink.kt"
        ]
      },
      {
        "id": "ov18-validation-evidence",
        "purpose": "Install apply-time OV18 verification without stopping Gradle daemons and update remediation closure evidence.",
        "paths": [
          ".devtool-artifact/validation/validate.sh",
          ".devtool.toml",
          "build.gradle.kts",
          "scripts/verify_ov18_native_tv_durable_state_action_journal.py",
          "scripts/validate_ov18_native_tv_durable_state_action_journal.sh",
          "docs/remediation/OV18_NATIVE_TV_DURABLE_CANONICAL_STATE.md",
          "docs/roadmap/FINAL_AUDIT_REMEDIATION_CLOSURE_LEDGER.md",
          "REMEDIATION_OV_18_IMPLEMENTATION.md",
          "CHANGELOG.md"
        ]
      }
    ]
  },
