  "name": "studyflow_ov07_backup_snapshot_saf_manual_sync_durability_v1",
  "target": "studyflow_android",
  "description": "Overlay 7 of 30: close S3-09 through S3-15, DS2-05, DS2-10, DS2-11, DS2-12, DS2-41, and S12-08 by hardening Desktop backup boundaries and size limits, annex/snapshot physical deletion and path safety, SAF grant lifecycle and wipeable secrets, duplicate annex identity validation, streaming manual-sync preview/staging, transaction-safe checkpoint capture, and recoverable logical database/annex restore with integrity verification before sync state advances.",
  "commit_message": "OV07: harden backup snapshot SAF and manual sync durability",
  "commit": {
    "enabled": true,
    "strategy": "single",
    "message": "OV07: harden backup snapshot SAF and manual sync durability"
  },
  "apply": {
    "commit": {
      "enabled": true,
      "strategy": "single",
      "message": "OV07: harden backup snapshot SAF and manual sync durability"
    }
  },
