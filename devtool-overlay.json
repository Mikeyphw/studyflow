    "format": 1,
    "name": "studyflow_ov17_attention_delivery_widget_remote_policy_v1",
    "target": "studyflow_android",
    "sections": [
      {
        "id": "ov17-widget-resilience",
        "purpose": "Isolate per-widget refresh failures and surface failed instance counts without aborting the refresh loop.",
        "paths": [
          "app/src/main/java/com/mikeyphw/studyflow/reminders/StudyFlowWidgetUpdateCoordinator.kt",
          "app/src/test/java/com/mikeyphw/studyflow/widget/StudyFlowWidgetOv17ResilienceContractTest.kt"
        ]
      },
      {
        "id": "ov17-remote-attention-recipient-policy",
        "purpose": "Apply recipient Android ATT10 focus/quiet-hours policy to inbound SFLP notifications and keep remote taps routed to canonical plan/type/target destinations.",
        "paths": [
          "app/src/main/java/com/mikeyphw/studyflow/reminders/StudyReminderDeliveryCoordinator.kt",
          "app/src/test/java/com/mikeyphw/studyflow/reminders/StudyReminderOv17DeliveryPolicyTest.kt"
        ]
      },
      {
        "id": "ov17-scheduler-bookkeeping-and-id-stability",
        "purpose": "Refresh quiet-hours timezone state, purge expired snoozes, and replace collision-prone hashCode notification IDs with SHA-256-derived IDs.",
        "paths": [
          "app/src/main/java/com/mikeyphw/studyflow/reminders/AndroidStudyFlowAttentionFocusPolicyStore.kt",
          "app/src/main/java/com/mikeyphw/studyflow/reminders/StudyReminderOccurrenceStore.kt"
        ]
      },
      {
        "id": "ov17-self-healing-invalidation-observers",
        "purpose": "Make process-lifetime widget and reminder invalidation collectors retry after transient repository/flow failures.",
        "paths": [
          "app/src/main/java/com/mikeyphw/studyflow/StudyFlowApplication.kt"
        ]
      },
      {
        "id": "ov17-validation-evidence",
        "purpose": "Install apply-time OV17 verification without stopping Gradle daemons and document closure against the final audit ledger.",
        "paths": [
          ".devtool-artifact/validation/validate.sh",
