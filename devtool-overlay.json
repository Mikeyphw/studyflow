  "findings": [
    {
      "id": "S11-02",
      "severity": "CRITICAL",
      "status": "closed",
      "summary": "Android Termux four-stage execution pipeline is now durably queued before launch."
    },
    {
      "id": "S11-03",
      "severity": "HIGH",
      "status": "closed",
      "summary": "Android manifest declares Termux package/action visibility required for current integration."
    },
    {
      "id": "S11-04",
      "severity": "HIGH",
      "status": "closed",
      "summary": "Termux results are persisted through the repository; volatile latest-result cache was removed."
    },
    {
      "id": "S11-09",
      "severity": "HIGH",
      "status": "closed",
      "summary": "Interpreter inline-code flags such as python -c, node -e, and bash -c are rejected."
    },
    {
      "id": "S11-10",
      "severity": "MEDIUM-HIGH",
      "status": "closed",
      "summary": "Termux workspaces are confined to configured StudyFlow roots; Android bridge uses that root."
    },
    {
      "id": "S11-11",
      "severity": "MEDIUM-HIGH",
      "status": "closed",
      "summary": "Quoted Termux command templates are parsed correctly without shell tokenization."
    },
    {
      "id": "S11-12",
      "severity": "HIGH",
      "status": "closed",
      "summary": "Termux results mutate exercises only after exact durable request/exercise correlation."
    },
    {
      "id": "S11-13",
      "severity": "MEDIUM",
      "status": "closed",
      "summary": "PendingIntent request codes use SHA-256 prefixes and unique data URIs to reduce collision/collapse risk."
    }
  ],
  "validation": {
