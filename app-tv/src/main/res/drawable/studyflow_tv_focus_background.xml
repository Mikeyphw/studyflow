<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1D4ED8" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#334155" />
            <stroke android:width="2dp" android:color="#C7D2FE" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#2563EB" />
            <stroke android:width="3dp" android:color="#BFDBFE" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1E293B" />
            <stroke android:width="1dp" android:color="#475569" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
