<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:appCategory="productivity"
        android:banner="@drawable/studyflow_tv_banner"
        android:dataExtractionRules="@xml/studyflow_tv_data_extraction_rules"
        android:description="@string/tv_app_description"
        android:fullBackupContent="@xml/studyflow_tv_backup_rules"
        android:icon="@drawable/studyflow_tv_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyFlowTv"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".StudyFlowTvActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
